# Belt-and-braces: nothing in this folder should ever be served directly,
# even though keys-store.php already returns a blank page if requested
# directly (PHP executes it, there's no echo).
#
# Portable across Apache 2.2 and 2.4 — using both directive styles
# unconditionally (without these IfModule guards) can 500-error on a
# pure 2.4 install with mod_access_compat disabled.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
